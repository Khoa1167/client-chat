# Dev local/Docker: để rỗng/tương đối — client gọi cùng-origin qua Vite proxy (server.proxy khi
# "npm run dev", preview.proxy khi chạy Docker — xem vite.config.js và VITE_PROXY_TARGET bên
# dưới), bắt buộc để cookie đăng nhập httpOnly gửi được (SameSite=Lax không tự gửi cookie
# cross-origin). Production (build trên Cloudflare Workers, xem client/worker/proxy.js): tương tự
# để rỗng/tương đối — Worker tự proxy /api và /socket.io sang Render, browser gọi cùng domain.
# KHÔNG trỏ thẳng domain onrender.com hay http://localhost:5000 nữa (cross-origin, cookie sẽ
# không gửi được).
VITE_API_URL=/api
VITE_SERVER_URL=

# Backend dùng cho Vite dev/preview. Nếu client chạy trong Docker riêng, đổi thành địa chỉ backend
# mà container truy cập được (ví dụ http://host.docker.internal:5000 trên Docker Desktop).
VITE_PROXY_TARGET=http://localhost:5000

# Cloudflare Turnstile Site Key (public, khác Secret Key phía server) — để trống thì widget không hiện
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
