{
  // Deploy static build của client/ qua Cloudflare Workers Static Assets, kèm 1 Worker script
  // ("main" bên dưới) đóng vai trò reverse-proxy /api và /socket.io sang backend Render — để
  // traffic API/WebSocket đi qua mạng Cloudflare (có DDoS protection) thay vì gọi thẳng domain
  // onrender.com trần trụi. Trước đây không có "main" vì chỉ là site tĩnh thuần; giờ cần Worker
  // script để tự quyết định route nào qua proxy, route nào trả static asset — tránh phụ thuộc
  // hành vi mặc định (assets-first vs worker-first) của Cloudflare khi có cả "main" lẫn "assets".
  // Đặt trong client/ vì form Git-connected Worker của Cloudflare có field "Path" (Advanced
  // settings) trỏ thẳng vào thư mục này — build/deploy command chạy với cwd = client/.
  // "name" PHẢI khớp đúng tên project/Worker đã tạo trên dashboard Cloudflare, không thì Wrangler
  // chỉ cảnh báo + tự override (không fail), nhưng để lệch sẽ khiến CI tự mở PR sửa lại config.
  "name": "dev-a-virtualyourself",
  "compatibility_date": "2026-08-24",
  "main": "./worker/proxy.js",
  // URL gốc backend Render — sửa ở đây (không sửa code) nếu sau này đổi domain/service Render.
  "vars": {
    "BACKEND_ORIGIN": "https://server-chat-sdcy.onrender.com",
    "VITE_CLOUDFLARE_TURNSTILE_SITE_KEY": "0x4AAAAAAEVLEJ5KEFp2kM9r"
  },
  // Rate limit ở edge Cloudflare — chặn burst request thô theo IP TRƯỚC khi tới Render, bổ sung
  // cho rate-limit chi tiết theo từng route đã có trong app (không thay thế). Hoạt động được trên
  // workers.dev, không cần domain/zone riêng như Bot Fight Mode/WAF. "period" chỉ nhận 10 hoặc 60
  // (giới hạn của Cloudflare, không tùy chỉnh được số khác).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    // Binding để worker/proxy.js tự gọi env.ASSETS.fetch() cho mọi request không phải /api hay
    // /socket.io — bắt buộc phải có "binding" khi vừa dùng "main" vừa dùng "assets", không thì
    // Worker script không có cách nào truy cập static asset qua env.
    "binding": "ASSETS",
    // Fallback về index.html cho mọi route không khớp file tĩnh nào, để React Router
    // (BrowserRouter) tự xử lý route phía client. KHÔNG dùng file _redirects kiểu Pages cũ song
    // song với field này — Workers Static Assets vẫn đọc/validate _redirects nếu có, và rule
    // catch-all "/* /index.html 200" bị nó coi là infinite loop (xung đột với chính cơ chế
    // not_found_handling này), làm deploy fail thẳng (đã gặp thật, không phải giả thuyết).
    "not_found_handling": "single-page-application"
  }
}
